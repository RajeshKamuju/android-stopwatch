<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Disabled State -->
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_disabled_bg" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/btn_disabled_stroke" />
        </shape>
    </item>
    <!-- Pressed State -->
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_lap_pressed" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <!-- Normal Enabled State -->
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/btn_lap_bg" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
